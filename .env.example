# Relay server configuration (see docs/plan/phase-1.md §8, phase-2.md §7, phase-3.md §8)

# HTTP listen address
RELAY_HTTP_ADDR=:7420

# gRPC listen address (separate port; see ADR 0014)
RELAY_GRPC_ADDR=:7421

# Enable gRPC server reflection (grpcurl); true in docker-compose, false locally
RELAY_GRPC_REFLECTION=false

# Storage backend: postgres | redis
RELAY_STORAGE=postgres

# Required when RELAY_STORAGE=postgres (host port 54329 matches docker-compose)
RELAY_POSTGRES_URL=postgres://relay:relay@localhost:54329/relay?sslmode=disable

# Required when RELAY_STORAGE=redis (host port 63799 matches docker-compose)
RELAY_REDIS_URL=redis://localhost:63799/0
RELAY_REDIS_KEY_PREFIX=relay

# Run goose migrations on serve (true in docker-compose; false for local make deps)
RELAY_MIGRATE_ON_START=false

# Optional bootstrap admin API key; empty + no stored keys → auth disabled (loud warning)
# Clients send: Authorization: Bearer <key>
# Prefer scoped keys via relayctl / POST /v1/api-keys / relay-server apikey create
RELAY_API_KEY=

# Verified API-key cache TTL (revocation effective within this window)
RELAY_AUTH_CACHE_TTL=30s

# Cron scheduler (leader-elected; see ADR 0011 / 0012)
RELAY_SCHEDULER_ENABLED=true
RELAY_SCHEDULER_TICK=1s

# Instance id for Redis leader leases (default: hostname-pid)
# RELAY_INSTANCE_ID=

# Retry policy: exponential (default, full jitter) | fixed
RELAY_RETRY_POLICY=exponential
RELAY_RETRY_BASE=1s
RELAY_RETRY_MAX=1h
# Legacy alias: used as RetryBase only when RELAY_RETRY_BASE is unset
# RELAY_RETRY_DELAY=5s

# Background reaper (expired leases across all queues)
RELAY_REAP_INTERVAL=5s
RELAY_REAP_BATCH=500

# Retention purge of terminal jobs (succeeded|dead|cancelled); 0 = never purge
RELAY_PURGE_INTERVAL=1m
RELAY_PURGE_BATCH=1000
RELAY_RETENTION=168h

# Minutely throughput stats retention for the dashboard (0 = never purge)
RELAY_STATS_RETENTION=48h

# Dashboard (/ui) — server-rendered; disable with RELAY_UI_ENABLED=false
RELAY_UI_ENABLED=true
# Base64-encoded 32-byte AES key for session cookies (required when RELAY_ENVIRONMENT=production)
# RELAY_UI_SESSION_KEY=
# Secure cookie flag (defaults: false in development, true in production)
# RELAY_UI_SECURE_COOKIES=false
# Optional Jaeger (or other) deep link; {trace_id} is substituted from W3C traceparent
# RELAY_UI_TRACE_URL_TEMPLATE=http://localhost:16686/trace/{trace_id}

# Max long-poll wait for POST /v1/queues/{queue}/leases (WriteTimeout = this + 15s)
RELAY_LEASE_MAX_WAIT=30s

# Graceful shutdown budget for HTTP server
# Drain budget after SIGTERM (default LeaseMaxWait+15s). Long-polls cancel via BaseContext.
RELAY_SHUTDOWN_TIMEOUT=45s

# slog level: debug | info | warn | error
RELAY_LOG_LEVEL=info

# slog format: json | text
RELAY_LOG_FORMAT=json

# Admin / metrics / pprof (private; compose maps 7429)
RELAY_ADMIN_ADDR=:7429

# Prometheus series cap for (queue, job_type) labels
RELAY_METRICS_MAX_SERIES=1000

# Deployment environment label for traces
RELAY_ENVIRONMENT=development

# Tracing (empty OTEL_EXPORTER_OTLP_ENDPOINT disables). Compose defaults to jaeger:4317.
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# OTEL_EXPORTER_OTLP_INSECURE=true
RELAY_TRACE_SAMPLE_RATIO=0.1

# Example worker metrics listen address (compose :9464)
# WORKER_METRICS_ADDR=:9464

# relayctl (optional; also --server / --api-key flags)
# RELAY_URL=http://localhost:7420
