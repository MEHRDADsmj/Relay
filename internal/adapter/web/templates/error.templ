package templates

templ ErrorPage(status int, title string, message string) {
	@Layout(title, "", false, errorBody(status, title, message))
}

templ errorBody(status int, title string, message string) {
	<div class="mx-auto max-w-lg text-center">
		<p class="text-sm font-medium uppercase tracking-wide text-zinc-500">{ statusLabel(status) }</p>
		<h1 class="mt-2 text-3xl font-semibold tracking-tight">{ title }</h1>
		<p class="mt-3 text-zinc-600 dark:text-zinc-400">{ message }</p>
		<p class="mt-8"><a href="/ui/">Back to overview</a></p>
	</div>
}

func statusLabel(status int) string {
	switch status {
	case 404:
		return "404"
	case 500:
		return "500"
	default:
		return ""
	}
}
