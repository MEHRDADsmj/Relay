      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "sum by (queue, result) (rate(relay_jobs_enqueued_total[1m]))",
          "legendFormat": "enqueue {{queue}} {{result}}",
          "refId": "A"
        },
        {
          "expr": "sum by (queue, outcome) (rate(relay_jobs_finished_total{outcome=\"succeeded\"}[1m]))",
          "legendFormat": "complete {{queue}}",
          "refId": "B"
        },
        {
          "expr": "sum by (queue, outcome) (rate(relay_jobs_finished_total{outcome=~\"failed|permanent\"}[1m]))",
          "legendFormat": "fail {{queue}} {{outcome}}",
          "refId": "C"
        }
      ],
      "title": "Enqueue / complete / fail rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
