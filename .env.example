# Relay server configuration (see docs/plan/phase-1.md §8 and phase-2.md §7)

# HTTP listen address
RELAY_HTTP_ADDR=:7420

# Storage backend: postgres | redis
RELAY_STORAGE=postgres

# Required when RELAY_STORAGE=postgres (host port 54329 matches docker-compose)
RELAY_POSTGRES_URL=postgres://relay:relay@localhost:54329/relay?sslmode=disable

# Required when RELAY_STORAGE=redis (host port 63799 matches docker-compose)
RELAY_REDIS_URL=redis://localhost:63799/0
RELAY_REDIS_KEY_PREFIX=relay

# Run goose migrations on serve (true in docker-compose; false for local make deps)
RELAY_MIGRATE_ON_START=false

# Optional static API key; empty disables auth (server logs a warning)
# Clients send: Authorization: Bearer <key>
RELAY_API_KEY=

# Retry policy: exponential (default, full jitter) | fixed
RELAY_RETRY_POLICY=exponential
RELAY_RETRY_BASE=1s
RELAY_RETRY_MAX=1h
# Legacy alias: used as RetryBase only when RELAY_RETRY_BASE is unset
# RELAY_RETRY_DELAY=5s

# Background reaper (expired leases across all queues)
RELAY_REAP_INTERVAL=5s
RELAY_REAP_BATCH=500

# Retention purge of terminal jobs (succeeded|dead|cancelled); 0 = never purge
RELAY_PURGE_INTERVAL=1m
RELAY_PURGE_BATCH=1000
RELAY_RETENTION=168h

# Max long-poll wait for POST /v1/queues/{queue}/leases (WriteTimeout = this + 15s)
RELAY_LEASE_MAX_WAIT=30s

# Graceful shutdown budget for HTTP server
# Drain budget after SIGTERM (default LeaseMaxWait+15s). Long-polls cancel via BaseContext.
RELAY_SHUTDOWN_TIMEOUT=45s

# slog level: debug | info | warn | error
RELAY_LOG_LEVEL=info

# slog format: json | text
RELAY_LOG_FORMAT=json
